{
  "name": "@toxiq/configurator",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/electron-codegen.mjs",
    "check": "tsc --noEmit && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/protocol.cjs && node --check electron/usb.cjs && node --check electron/keyboard.cjs",
    "test": "node scripts/electron-codegen.mjs && node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serialport": "^13.0.0",
    "vite": "^8.3.2"
  },
  "description": "TOXIQ desktop USB configurator",
  "author": "TOXIQ",
  "build": {
    "appId": "cz.toxiq.configurator",
    "productName": "TOXIQ Configurator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TOXIQ-Configurator-${version}-Setup.exe",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../assets/fonts/OFL.txt",
        "to": "licenses/Inter-OFL.txt"
      }
    ]
  }
}
